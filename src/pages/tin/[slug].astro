---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.(md|mdx)$/i, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const title = post.data.title ?? 'Bài viết';
const description = post.data.description ?? '';
const image = post.data.image ?? '';
const dateText = post.data.date
  ? new Date(post.data.date).toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' })
  : '';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "datePublished": post.data.date ?? '',
};
---

<Layout
  title={title}
  description={description}
  ogImage={image}
  ogType="article"
  jsonLd={jsonLd}
>
  <div class="max-w-4xl mx-auto px-4 py-8">
    <nav class="text-sm text-gray-500 dark:text-slate-400 mb-6">
      <a href="/" class="hover:text-red-600 dark:hover:text-red-400">Trang chủ</a>
      <span class="mx-2">/</span>
      <a href="/tin-tuc" class="hover:text-red-600 dark:hover:text-red-400">Tin tức</a>
      <span class="mx-2">/</span>
      <span class="text-gray-900 dark:text-white font-medium">{title}</span>
    </nav>

    <article class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm p-6 md:p-10 border border-gray-100 dark:border-slate-800">
      <h1 class="text-3xl md:text-4xl font-extrabold mb-4">{title}</h1>
      {dateText && <p class="text-sm text-gray-500 dark:text-slate-400 mb-6">{dateText}</p>}
      {image && <img src={image} alt={title} class="w-full rounded-xl mb-6" />}
      <div class="prose dark:prose-invert max-w-none">
        <Content />
      </div>
    </article>
  </div>
</Layout>
