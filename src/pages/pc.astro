---
import Layout from '../layouts/Layout.astro';
import CategoryPage from '../components/CategoryPage.astro';
import { getCollection } from 'astro:content';
import games from '../data/games.json';
import { latestPostImageMap } from '../lib/gameArt';

const list = games.filter((g) => g.category === 'pc-console');
const postImages = latestPostImageMap(
  (await getCollection('posts')).map((p) => ({
    gameSlug: p.data.game || '',
    image: p.data.image || '',
    _ts: p.data.date ? new Date(p.data.date).getTime() : 0,
  }))
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Game PC / Console',
  itemListElement: list.map((g, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: g.name,
    url: `https://game8.vn/game/${g.slug}/`,
  })),
};
---

<Layout
  title="Game PC / Console - Game Steam, PlayStation, Xbox, Switch"
  description="Tổng hợp game PC và console đáng chơi nhất: Steam, PlayStation, Xbox, Nintendo Switch — từ indie tới bom tấn AAA."
  keywords="game pc, game console, game steam, game ps5, game xbox, game switch"
  jsonLd={jsonLd}
>
  <CategoryPage title="Game PC / Console" subtitle="Steam, PlayStation, Xbox, Switch" list={list} postImages={postImages} />
</Layout>
