---
import Layout from '../layouts/Layout.astro';
import NewsRow from '../components/NewsRow.astro';
import { getCollection } from 'astro:content';
import games from '../data/games.json';

const fmtDate = (d: any) =>
  d ? new Date(d).toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' }) : '';
const gameBySlug = Object.fromEntries(games.map((g) => [g.slug, g]));

const entries = await getCollection('posts');
const posts = entries
  .map((p) => ({
    slug: p.id.replace(/\.(md|mdx)$/i, ''),
    title: p.data.title ?? 'Bài viết',
    description: p.data.description ?? '',
    image: p.data.image ?? '',
    tag: (p.data.tags && p.data.tags[0]) || 'Tin tức',
    tags: p.data.tags || [],
    dateText: fmtDate(p.data.date),
    _ts: p.data.date ? new Date(p.data.date).getTime() : 0,
    gameSlug: p.data.game || '',
  }))
  .sort((a, b) => b._ts - a._ts);

const allTags = [...new Set(posts.flatMap((p) => p.tags))];
---

<Layout
  title="Tin tức game mới nhất"
  description="Tin tức game mới nhất: game mobile, game PC/console, review và sự kiện từ các NPH VTC, VNG, Funtap, Gosu."
  keywords="tin game, tin tức game, review game, game mới ra mắt"
>
  <div class="max-w-[1280px] mx-auto px-4 py-6">
    <h1 class="text-3xl sm:text-4xl font-extrabold">Cập nhật mới</h1>
    <p class="muted mt-1">Bản vá, hướng dẫn và sự kiện mới nhất từ các game</p>

    {allTags.length > 0 && (
      <div class="hs flex gap-2 mt-5 mb-6" id="tag-bar">
        {['Tất cả', ...allTags].map((x) => (
          <button class={`chip ${x === 'Tất cả' ? 'chip-on' : ''}`} data-tag={x}>{x}</button>
        ))}
      </div>
    )}

    {posts.length > 0 ? (
      <div class="grid lg:grid-cols-2 gap-4" id="post-grid">
        {posts.map((p) => <NewsRow post={p} game={gameBySlug[p.gameSlug]} />)}
      </div>
    ) : (
      <div class="sf rounded-2xl p-12 text-center">
        <p class="muted">Chưa có bài viết nào. Hãy quay lại sau!</p>
      </div>
    )}
    <p id="post-empty" class="hidden text-center muted py-16 font-medium">Chưa có bài viết nào thuộc mục này.</p>
  </div>
</Layout>

<script>
  const rows = [...document.querySelectorAll('.news-row')];
  const empty = document.getElementById('post-empty');
  document.querySelectorAll('#tag-bar .chip').forEach((chip) => {
    chip.addEventListener('click', () => {
      const tag = ((chip as HTMLElement).dataset.tag || 'Tất cả').toLowerCase();
      document.querySelectorAll('#tag-bar .chip').forEach((x) => x.classList.toggle('chip-on', x === chip));
      let visible = 0;
      rows.forEach((r) => {
        const el = r as HTMLElement;
        const show = tag === 'tất cả' || (el.dataset.tags || '').split('|').includes(tag);
        el.classList.toggle('hidden', !show);
        if (show) visible++;
      });
      empty?.classList.toggle('hidden', visible > 0);
    });
  });
</script>
