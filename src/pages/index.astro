---
import Layout from '../layouts/Layout.astro';
import games from '../data/games.json';

const mobileGames = games.filter((g) => g.category === 'mobile');
const pcGames = games.filter((g) => g.category === 'pc-console');

const featuredSlugs = ['crimson-desert', 'monster-hunter-wilds', 'hollow-knight-silksong', 'elden-ring-nightreign', 'audition'];
const featuredGames = featuredSlugs
  .map((s) => games.find((g) => g.slug === s))
  .filter(Boolean);

const getGame = (slug) => games.find((g) => g.slug === slug);
const mobileCover = getGame('genshin-impact')?.cover;
const pcCover = getGame('monster-hunter-wilds')?.cover;
const hotCover = getGame('crimson-desert')?.cover;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Game8.VN",
  "url": "https://game8.vn",
  "description": "Cổng thông tin game Việt Nam — tải game mobile, game PC/console, tin tức và review.",
};
---

<Layout
  title="Game8.VN - Tải game mobile, game PC, tin tức game mới nhất"
  description="Game8.VN — cổng thông tin game Việt Nam: tải game mobile VTC, VNG, Funtap, Gosu; game PC/console; tin tức và review game mới nhất."
  keywords="game mobile, game pc, tải game, VTC Game, VNG, Funtap, Gosu, tin game, review game"
  jsonLd={jsonLd}
>
  <div class="bg-slate-950 text-white min-h-screen">
    <!-- ============ HERO CAROUSEL ============ -->
    <section id="hero-carousel" class="relative overflow-hidden h-[540px] md:h-[600px]">
      {featuredGames.map((game, i) => (
        <div
          class={`hero-slide absolute inset-0 transition-opacity duration-1000 ${i === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`}
          data-slide={i}
        >
          <img src={game.cover} alt={game.name} class="absolute inset-0 w-full h-full object-cover" />
          <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/70 to-transparent"></div>
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-slate-950/40"></div>
          <div class="relative h-full max-w-7xl mx-auto px-4 flex flex-col justify-center">
            <span class="inline-flex w-fit items-center gap-1.5 text-xs font-bold uppercase tracking-widest text-amber-400 bg-amber-400/10 border border-amber-400/30 px-3 py-1.5 rounded-full mb-5">
              🔥 Nổi bật
            </span>
            <h1 class="text-4xl md:text-6xl font-black tracking-tight mb-4 max-w-2xl drop-shadow-2xl">{game.name}</h1>
            <div class="flex flex-wrap gap-2 mb-4">
              <span class="text-xs font-semibold bg-white/10 backdrop-blur border border-white/20 px-3 py-1.5 rounded-full">{game.genre}</span>
              <span class="text-xs font-semibold bg-white/10 backdrop-blur border border-white/20 px-3 py-1.5 rounded-full">{game.publisher}</span>
            </div>
            <p class="text-slate-300 max-w-xl mb-8 line-clamp-2">{game.description}</p>
            <div>
              <a href={`/game/${game.slug}/`} class="inline-flex items-center gap-2 bg-gradient-to-r from-red-600 to-orange-500 hover:from-red-500 hover:to-orange-400 font-bold px-8 py-3.5 rounded-full shadow-2xl shadow-orange-900/50 hover:shadow-orange-800/60 hover:-translate-y-0.5 transition-all duration-300">
                Xem chi tiết
                <span>→</span>
              </a>
            </div>
          </div>
        </div>
      ))}

      <!-- Arrows -->
      <button id="hero-prev" aria-label="Slide trước" class="absolute left-4 top-1/2 -translate-y-1/2 z-20 w-12 h-12 rounded-full bg-white/10 hover:bg-white/25 backdrop-blur border border-white/20 flex items-center justify-center text-2xl transition">‹</button>
      <button id="hero-next" aria-label="Slide tiếp" class="absolute right-4 top-1/2 -translate-y-1/2 z-20 w-12 h-12 rounded-full bg-white/10 hover:bg-white/25 backdrop-blur border border-white/20 flex items-center justify-center text-2xl transition">›</button>

      <!-- Dots -->
      <div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-20 flex gap-2.5">
        {featuredGames.map((_, i) => (
          <button
            aria-label={`Slide ${i + 1}`}
            data-dot={i}
            class={`hero-dot h-2.5 rounded-full transition-all duration-300 ${i === 0 ? 'w-8 bg-orange-500' : 'w-2.5 bg-white/40 hover:bg-white/70'}`}
          ></button>
        ))}
      </div>
    </section>

    <!-- ============ CATEGORY CARDS ============ -->
    <section class="max-w-7xl mx-auto px-4 -mt-2 py-12">
      <h2 class="text-2xl md:text-3xl font-black tracking-tight mb-6">Khám phá Game8.VN</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <a href="#mobile" class="group relative overflow-hidden rounded-3xl h-44 md:h-52 block">
          {mobileCover && <img src={mobileCover} alt="Game Mobile" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" loading="lazy" />}
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/50 to-transparent"></div>
          <div class="absolute bottom-0 p-6">
            <h3 class="text-2xl font-black mb-1">📱 Game Mobile</h3>
            <p class="text-sm text-slate-300">Game mobile từ VTC, VNG, Funtap, Gosu</p>
            <span class="inline-flex items-center gap-1 text-sm font-bold text-orange-400 mt-2 group-hover:gap-3 transition-all">Khám phá <span>→</span></span>
          </div>
        </a>
        <a href="#pc-console" class="group relative overflow-hidden rounded-3xl h-44 md:h-52 block">
          {pcCover && <img src={pcCover} alt="Game PC Console" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" loading="lazy" />}
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/50 to-transparent"></div>
          <div class="absolute bottom-0 p-6">
            <h3 class="text-2xl font-black mb-1">🖥️ Game PC / Console</h3>
            <p class="text-sm text-slate-300">Game PC, Steam và console bom tấn</p>
            <span class="inline-flex items-center gap-1 text-sm font-bold text-orange-400 mt-2 group-hover:gap-3 transition-all">Khám phá <span>→</span></span>
          </div>
        </a>
        <a href="#hot" class="group relative overflow-hidden rounded-3xl h-44 md:h-52 block">
          {hotCover && <img src={hotCover} alt="Game Hot" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" loading="lazy" />}
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/50 to-transparent"></div>
          <div class="absolute bottom-0 p-6">
            <h3 class="text-2xl font-black mb-1">🔥 Game Hot</h3>
            <p class="text-sm text-slate-300">Những tựa game đang được săn đón nhất</p>
            <span class="inline-flex items-center gap-1 text-sm font-bold text-orange-400 mt-2 group-hover:gap-3 transition-all">Khám phá <span>→</span></span>
          </div>
        </a>
      </div>
    </section>

    <!-- ============ GAME HOT ROW ============ -->
    <section id="hot" class="max-w-7xl mx-auto px-4 pb-12">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl md:text-3xl font-black tracking-tight">🔥 Game Hot</h2>
      </div>
      <div class="flex gap-5 overflow-x-auto pb-4 snap-x" style="scrollbar-width: thin;">
        {featuredGames.map((game) => (
          <a href={`/game/${game.slug}/`} class="group snap-start shrink-0 w-64 bg-slate-900 rounded-3xl overflow-hidden border border-slate-800 hover:border-orange-500/60 hover:shadow-2xl hover:shadow-orange-950/50 hover:-translate-y-1.5 transition-all duration-300">
            <div class="relative h-36 overflow-hidden">
              {game.cover ? (
                <img src={game.cover} alt={game.name} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" loading="lazy" />
              ) : (
                <div class="w-full h-full bg-gradient-to-br from-red-600 to-orange-500"></div>
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-slate-900 to-transparent"></div>
            </div>
            <div class="p-4 flex items-center gap-3">
              {game.icon ? (
                <img src={game.icon} alt={`Icon ${game.name}`} width="56" height="56" class="w-14 h-14 rounded-2xl object-cover shadow-lg shrink-0" loading="lazy" />
              ) : (
                <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-red-500 to-orange-500 flex items-center justify-center text-white text-xl font-black shrink-0">{game.name.charAt(0)}</div>
              )}
              <div class="min-w-0">
                <h3 class="font-bold text-sm line-clamp-1">{game.name}</h3>
                <p class="text-xs text-slate-400 truncate">{game.publisher}</p>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- ============ GAME MOBILE GRID ============ -->
    <section id="mobile" class="max-w-7xl mx-auto px-4 pb-14">
      <h2 class="text-2xl md:text-3xl font-black tracking-tight mb-6">📱 Game Mobile</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-5">
        {mobileGames.map((game) => (
          <a href={`/game/${game.slug}/`} class="group bg-slate-900 rounded-3xl p-6 flex flex-col items-center text-center border border-slate-800 hover:border-orange-500/60 hover:shadow-2xl hover:shadow-orange-950/40 hover:-translate-y-1.5 transition-all duration-300">
            {game.icon ? (
              <img src={game.icon} alt={`Icon ${game.name}`} width="130" height="130" class="w-[130px] h-[130px] rounded-[28px] object-cover mb-4 shadow-xl shadow-black/50 ring-1 ring-white/10 group-hover:ring-orange-500/50 group-hover:scale-105 group-hover:shadow-orange-950/40 transition-all duration-300" loading="lazy" />
            ) : (
              <div class="w-[130px] h-[130px] rounded-[28px] bg-gradient-to-br from-red-500 via-orange-500 to-amber-500 flex items-center justify-center text-white text-5xl font-black mb-4 shadow-xl shadow-black/50">
                {game.name.charAt(0)}
              </div>
            )}
            <h3 class="font-bold text-[15px] leading-snug line-clamp-2 mb-2 min-h-[2.6em]">{game.name}</h3>
            <span class="text-xs font-semibold text-orange-400 bg-orange-500/10 border border-orange-500/20 px-2.5 py-1 rounded-full mb-1.5">{game.genre}</span>
            <p class="text-xs text-slate-500">{game.publisher}</p>
          </a>
        ))}
      </div>
    </section>

    <!-- ============ GAME PC/CONSOLE GRID ============ -->
    <section id="pc-console" class="max-w-7xl mx-auto px-4 pb-16">
      <h2 class="text-2xl md:text-3xl font-black tracking-tight mb-6">🖥️ Game PC / Console</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-5">
        {pcGames.map((game) => (
          <a href={`/game/${game.slug}/`} class="group bg-slate-900 rounded-3xl p-6 flex flex-col items-center text-center border border-slate-800 hover:border-cyan-500/60 hover:shadow-2xl hover:shadow-cyan-950/40 hover:-translate-y-1.5 transition-all duration-300">
            {game.icon ? (
              <img src={game.icon} alt={`Icon ${game.name}`} width="130" height="130" class="w-[130px] h-[130px] rounded-[28px] object-cover mb-4 shadow-xl shadow-black/50 ring-1 ring-white/10 group-hover:ring-cyan-500/50 group-hover:scale-105 group-hover:shadow-cyan-950/40 transition-all duration-300" loading="lazy" />
            ) : (
              <div class="w-[130px] h-[130px] rounded-[28px] bg-gradient-to-br from-indigo-600 via-blue-600 to-cyan-500 flex items-center justify-center text-white text-5xl font-black mb-4 shadow-xl shadow-black/50">
                {game.name.charAt(0)}
              </div>
            )}
            <h3 class="font-bold text-[15px] leading-snug line-clamp-2 mb-2 min-h-[2.6em]">{game.name}</h3>
            <span class="text-xs font-semibold text-cyan-400 bg-cyan-500/10 border border-cyan-500/20 px-2.5 py-1 rounded-full mb-1.5">{game.genre}</span>
            <p class="text-xs text-slate-500">{game.publisher}</p>
          </a>
        ))}
      </div>
    </section>
  </div>
</Layout>

<script>
  const slides = document.querySelectorAll('.hero-slide');
  const dots = document.querySelectorAll('.hero-dot');
  let current = 0;
  let timer;

  function goTo(i) {
    current = (i + slides.length) % slides.length;
    slides.forEach((s, idx) => {
      s.classList.toggle('opacity-100', idx === current);
      s.classList.toggle('z-10', idx === current);
      s.classList.toggle('opacity-0', idx !== current);
      s.classList.toggle('z-0', idx !== current);
    });
    dots.forEach((d, idx) => {
      d.className = `hero-dot h-2.5 rounded-full transition-all duration-300 ${idx === current ? 'w-8 bg-orange-500' : 'w-2.5 bg-white/40 hover:bg-white/70'}`;
    });
  }

  function restart() {
    clearInterval(timer);
    timer = setInterval(() => goTo(current + 1), 6000);
  }

  document.getElementById('hero-prev').addEventListener('click', () => { goTo(current - 1); restart(); });
  document.getElementById('hero-next').addEventListener('click', () => { goTo(current + 1); restart(); });
  dots.forEach((d) => d.addEventListener('click', () => { goTo(Number(d.dataset.dot)); restart(); }));

  const carousel = document.getElementById('hero-carousel');
  carousel.addEventListener('mouseenter', () => clearInterval(timer));
  carousel.addEventListener('mouseleave', restart);
  restart();
</script>

<style>
  .line-clamp-1 {
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  html { scroll-behavior: smooth; }
</style>
