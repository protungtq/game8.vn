---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import NewsRow from '../components/NewsRow.astro';
import { getCollection } from 'astro:content';
import games from '../data/games.json';
import { gameArt, latestPostImageMap } from '../lib/gameArt';

// ===== Hero: game nổi bật có ảnh bìa =====
const featuredSlugs = ['crimson-desert', 'monster-hunter-wilds', 'elden-ring-nightreign', 'hollow-knight-silksong', 'valorant', 'genshin-impact'];
const featured = featuredSlugs
  .map((s) => games.find((g) => g.slug === s))
  .filter((g) => g && g.cover)
  .slice(0, 6);

const mobileGames = games.filter((g) => g.category === 'mobile');
const pcGames = games.filter((g) => g.category === 'pc-console');

// ===== Bài viết mới nhất =====
const fmtDate = (d: any) =>
  d ? new Date(d).toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' }) : '';
const gameBySlug = Object.fromEntries(games.map((g) => [g.slug, g]));
const allPostVMs = (await getCollection('posts'))
  .map((p) => ({
    slug: p.id.replace(/\.(md|mdx)$/i, ''),
    title: p.data.title,
    description: p.data.description || '',
    image: p.data.image || '',
    tag: (p.data.tags && p.data.tags[0]) || 'Tin tức',
    tags: p.data.tags || [],
    dateText: fmtDate(p.data.date),
    _ts: p.data.date ? new Date(p.data.date).getTime() : 0,
    gameSlug: p.data.game || '',
  }))
  .sort((a, b) => b._ts - a._ts);
const latestPosts = allPostVMs.slice(0, 6);
const postImageMap = latestPostImageMap(allPostVMs);

// ===== Khối thịnh hành: thẻ game + thẻ tuyển tập =====
const trending = [
  games.find((g) => g.slug === 'lien-quan-mobile') || mobileGames[0],
  games.find((g) => g.slug === 'pubg-mobile') || mobileGames[1],
  games.find((g) => g.slug === 'valorant') || pcGames[0],
  games.find((g) => g.slug === 'genshin-impact') || pcGames[1],
].filter(Boolean);
const mmorpgSet = games.filter((g) => (g.genre || '').includes('MMORPG') && gameArt(g, postImageMap[g.slug])).slice(0, 4);
const mobileSet = mobileGames.filter((g) => gameArt(g, postImageMap[g.slug])).slice(0, 4);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Game8.VN",
  "url": "https://game8.vn",
  "description": "Cổng thông tin game Việt Nam — tải game mobile, game PC/console, tin tức và review.",
};
---

<Layout
  title="Game8.VN - Tải game mobile, game PC, tin tức game mới nhất"
  description="Game8.VN — cổng thông tin game Việt Nam: tải game mobile VTC, VNG, Funtap, Gosu; game PC/console; tin tức và review game mới nhất."
  keywords="game mobile, game pc, tải game, VTC Game, VNG, Funtap, Gosu, tin game, review game"
  jsonLd={jsonLd}
>
  <div class="max-w-[1280px] mx-auto px-4 py-6">

    <!-- ============ HERO ============ -->
    <div id="hero" class="sf rounded-3xl p-2.5 grid lg:grid-cols-[1fr_340px] gap-3">
      <div class="min-w-0">
        <div class="relative aspect-[16/10] sm:aspect-video rounded-2xl overflow-hidden">
          {featured.map((game, i) => (
            <a
              href={`/game/${game.slug}/`}
              class={`hero-slide absolute inset-0 text-white transition-opacity duration-700 ${i === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none'}`}
              data-slide={i}
            >
              <img src={game.cover} alt={game.name} class="absolute inset-0 w-full h-full object-cover" loading={i === 0 ? 'eager' : 'lazy'} />
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
              <div class="absolute inset-x-0 bottom-0 p-5 sm:p-7">
                <h1 class="text-2xl sm:text-4xl font-extrabold">{game.name}</h1>
                <p class="mt-1.5 text-sm sm:text-lg font-semibold text-white/90 line-clamp-2 max-w-2xl">{game.description}</p>
                <div class="mt-3 flex flex-wrap gap-2">
                  <span class="text-xs font-semibold text-white bg-white/15 backdrop-blur border border-white/25 px-3 py-1.5 rounded-full">{game.genre}</span>
                  <span class="text-xs font-semibold text-white bg-white/15 backdrop-blur border border-white/25 px-3 py-1.5 rounded-full">{game.publisher}</span>
                </div>
              </div>
            </a>
          ))}
        </div>
        <div class="flex justify-center gap-1.5 mt-3 lg:hidden">
          {featured.map((_, i) => (
            <button aria-label={`Slide ${i + 1}`} data-dot={i} class={`hero-dot h-1.5 rounded-full transition-all ${i === 0 ? 'w-6 bg-tap' : 'w-1.5 bg-black/20 dark:bg-white/30'}`}></button>
          ))}
        </div>
      </div>
      <div class="hidden lg:block relative">
        <div class="absolute inset-0 overflow-y-auto fadeb space-y-1 pb-10" style="scrollbar-width:none">
          {featured.map((game, i) => (
            <button data-pl={i} class={`hero-pl w-full flex items-center gap-3 p-2 rounded-xl text-left transition ${i === 0 ? 'bg-black/10 dark:bg-white/15 ring-1 ring-[#15171a] dark:ring-white/60' : 'hover:bg-black/5 dark:hover:bg-white/5'}`}>
              <span class="w-36 aspect-[16/10] rounded-lg overflow-hidden relative shrink-0 block">
                <img src={game.cover} alt={game.name} loading="lazy" class="absolute inset-0 w-full h-full object-cover" />
              </span>
              <span class="min-w-0 flex-1">
                <span class="block font-bold truncate">{game.name}</span>
                <span class="block text-xs muted mt-1 truncate">{game.genre}{game.rating != null ? ` · ★ ${Number(game.rating).toFixed(1)}` : ` · ${game.publisher}`}</span>
              </span>
            </button>
          ))}
        </div>
      </div>
    </div>

    <!-- ============ THỊNH HÀNH ============ -->
    <section class="mt-10">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xl font-extrabold">Game & chủ đề đang thịnh hành</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-5 gap-y-8">
        <GameCard game={trending[0]} postImg={postImageMap[trending[0].slug]} />
        <GameCard game={trending[1]} postImg={postImageMap[trending[1].slug]} />
        <a href="/pc/" class="group block fade">
          <div class="relative aspect-video rounded-2xl overflow-hidden flex ring-1 ring-black/5 dark:ring-white/10">
            {mmorpgSet.map((g) => (
              <div class="flex-1 relative overflow-hidden">
                <img src={gameArt(g, postImageMap[g.slug])} alt={g.name} loading="lazy" class="absolute inset-0 w-full h-full object-cover" />
              </div>
            ))}
            <span class="absolute left-2 top-2 text-xs bg-white/90 text-slate-700 rounded-full px-3 py-1 font-medium">Danh sách game</span>
          </div>
          <h3 class="mt-3 text-xl font-extrabold">Tuyển tập MMORPG đáng chơi</h3>
          <div class="flex flex-wrap gap-1.5 mt-2">
            {mmorpgSet.map((g) => <span class="text-xs rounded-full sf muted px-3 py-1">{g.name}</span>)}
          </div>
        </a>
        <GameCard game={trending[2]} postImg={postImageMap[trending[2].slug]} />
        <GameCard game={trending[3]} postImg={postImageMap[trending[3].slug]} />
        <a href="/mobile/" class="group block fade">
          <div class="relative aspect-video rounded-2xl overflow-hidden flex ring-1 ring-black/5 dark:ring-white/10">
            {mobileSet.map((g) => (
              <div class="flex-1 relative overflow-hidden">
                <img src={gameArt(g, postImageMap[g.slug])} alt={g.name} loading="lazy" class="absolute inset-0 w-full h-full object-cover" />
              </div>
            ))}
            <span class="absolute left-2 top-2 text-xs bg-white/90 text-slate-700 rounded-full px-3 py-1 font-medium">Danh sách game</span>
          </div>
          <h3 class="mt-3 text-xl font-extrabold">Game Mobile đang được chơi nhiều</h3>
          <div class="flex flex-wrap gap-1.5 mt-2">
            {mobileSet.map((g) => <span class="text-xs rounded-full sf muted px-3 py-1">{g.name}</span>)}
          </div>
        </a>
      </div>
    </section>

    <!-- ============ GAME MOBILE ============ -->
    <section class="mt-10">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xl font-extrabold">Game Mobile</h2>
        <a href="/mobile/" class="text-sm font-semibold muted hover:text-tap flex items-center">Xem thêm
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
        </a>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-5 gap-y-8">
        {mobileGames.slice(0, 6).map((g) => <GameCard game={g} postImg={postImageMap[g.slug]} />)}
      </div>
    </section>

    <!-- ============ GAME PC / CONSOLE ============ -->
    <section class="mt-10">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xl font-extrabold">Game PC / Console</h2>
        <a href="/pc/" class="text-sm font-semibold muted hover:text-tap flex items-center">Xem thêm
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
        </a>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-5 gap-y-8">
        {pcGames.slice(0, 6).map((g) => <GameCard game={g} postImg={postImageMap[g.slug]} />)}
      </div>
    </section>

    <!-- ============ CẬP NHẬT MỚI ============ -->
    {latestPosts.length > 0 && (
      <section class="mt-10">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-xl font-extrabold">Cập nhật mới</h2>
          <a href="/cap-nhat/" class="text-sm font-semibold muted hover:text-tap flex items-center">Xem thêm
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
          </a>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {latestPosts.map((p) => <NewsRow post={p} game={gameBySlug[p.gameSlug]} postImg={postImageMap[p.gameSlug]} />)}
        </div>
      </section>
    )}
  </div>
</Layout>

<script>
  const slides = document.querySelectorAll('.hero-slide');
  const dots = document.querySelectorAll('.hero-dot');
  const pls = document.querySelectorAll('.hero-pl');
  let cur = 0;
  let timer: any;

  function goTo(i: number) {
    if (!slides.length) return;
    cur = (i + slides.length) % slides.length;
    slides.forEach((s, idx) => {
      s.classList.toggle('opacity-100', idx === cur);
      s.classList.toggle('z-10', idx === cur);
      s.classList.toggle('opacity-0', idx !== cur);
      s.classList.toggle('pointer-events-none', idx !== cur);
    });
    dots.forEach((d, idx) => {
      d.className = `hero-dot h-1.5 rounded-full transition-all ${idx === cur ? 'w-6 bg-tap' : 'w-1.5 bg-black/20 dark:bg-white/30'}`;
    });
    pls.forEach((b, idx) => {
      b.className = `hero-pl w-full flex items-center gap-3 p-2 rounded-xl text-left transition ${idx === cur ? 'bg-black/10 dark:bg-white/15 ring-1 ring-[#15171a] dark:ring-white/60' : 'hover:bg-black/5 dark:hover:bg-white/5'}`;
    });
  }
  function restart() {
    clearInterval(timer);
    timer = setInterval(() => goTo(cur + 1), 6000);
  }
  dots.forEach((d) => d.addEventListener('click', () => { goTo(Number((d as HTMLElement).dataset.dot)); restart(); }));
  pls.forEach((b) => b.addEventListener('click', () => { goTo(Number((b as HTMLElement).dataset.pl)); restart(); }));
  const hero = document.getElementById('hero');
  hero?.addEventListener('mouseenter', () => clearInterval(timer));
  hero?.addEventListener('mouseleave', restart);
  restart();
</script>
