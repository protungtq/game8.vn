---
import Layout from '../../layouts/Layout.astro';
import NewsRow from '../../components/NewsRow.astro';
import { getCollection } from 'astro:content';
import games from '../../data/games.json';
import { gameArt, latestPostImageMap } from '../../lib/gameArt';

export async function getStaticPaths() {
  const entries = await getCollection('posts');
  const fmt = (d: any) =>
    d ? new Date(d).toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' }) : '';
  const posts = entries.map((p) => ({
    slug: p.id.replace(/\.(md|mdx)$/i, ''),
    title: p.data.title,
    description: p.data.description || '',
    image: p.data.image || '',
    tag: (p.data.tags && p.data.tags[0]) || 'Cập nhật',
    tags: p.data.tags || [],
    dateText: fmt(p.data.date),
    _ts: p.data.date ? new Date(p.data.date).getTime() : 0,
    gameSlug: p.data.game || '',
  }));
  const imgMap = latestPostImageMap(posts);
  return games.map((game) => ({
    params: { slug: game.slug },
    props: {
      game,
      relatedPosts: posts.filter((p) => p.gameSlug === game.slug).sort((a, b) => b._ts - a._ts),
      postImg: imgMap[game.slug] || '',
    },
  }));
}

const { game, relatedPosts, postImg } = Astro.props;

const isMobile = game.category === 'mobile';
const catHref = isMobile ? '/mobile/' : '/pc/';
const catLabel = isMobile ? 'Game Mobile' : 'Game PC / Console';
const platText = (game.platforms || []).join(' · ');

const relatedGames = games
  .filter((g) => g.slug !== game.slug && g.category === game.category)
  .sort((a, b) => {
    const sa = a.genre === game.genre ? 0 : 1;
    const sb = b.genre === game.genre ? 0 : 1;
    return sa - sb;
  })
  .slice(0, 4);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "VideoGame",
  "name": game.name,
  "description": game.description,
  "genre": game.genre,
  "publisher": { "@type": "Organization", "name": game.publisher },
  ...(game.icon && { "image": game.icon }),
  ...(game.trailer && { "trailer": { "@type": "VideoObject", "embedUrl": game.trailer } }),
};

function youtubeEmbed(url: string): string {
  if (!url) return '';
  const m = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/)([a-zA-Z0-9_-]+)/);
  return m ? `https://www.youtube.com/embed/${m[1]}` : '';
}

const embedUrl = youtubeEmbed(game.trailer);

// Điểm đánh giá: điền tay trong dữ liệu (rating), hiển thị 1 chữ số lẻ + sao
const ratingVal = typeof game.rating === 'number' ? game.rating : null;
const filledStars = ratingVal != null ? Math.round(ratingVal / 2) : 0;
const starPath = 'M10 1.5l2.6 5.6 6.1.7-4.5 4.2 1.2 6-5.4-3-5.4 3 1.2-6L1.3 7.8l6.1-.7z';

// Header kiểu app-store (mobile): biểu tượng nền tảng + nút tải chính/phụ
const GLYPH: Record<string, string> = {
  android: 'M6 18c0 .6.4 1 1 1h1v3a1.5 1.5 0 003 0v-3h2v3a1.5 1.5 0 003 0v-3h1c.6 0 1-.4 1-1V8H6zM3.5 8A1.5 1.5 0 002 9.5v6a1.5 1.5 0 003 0v-6A1.5 1.5 0 003.5 8zm17 0a1.5 1.5 0 00-1.5 1.5v6a1.5 1.5 0 003 0v-6A1.5 1.5 0 0020.5 8zM15.5 2.2l1.3-1.3-.5-.5-1.5 1.5A6 6 0 0012 1.5c-.9 0-1.7.2-2.3.6L8.2.4l-.5.5 1.3 1.3A5.900 5.900 0 006 7h12a5.900 5.900 0 00-2.500-4.800z',
  ios: 'M16.400 12.600c0-2.300 1.900-3.400 2-3.500-1.100-1.600-2.800-1.800-3.400-1.800-1.400-.1-2.800.8-3.500.8s-1.800-.8-3-.8C6.900 7.400 5.400 8.300 4.600 9.700c-1.700 2.900-.4 7.100 1.200 9.400.8 1.100 1.700 2.400 2.900 2.300 1.200 0 1.600-.7 3-.7s1.800.7 3 .7c1.300 0 2.100-1.100 2.800-2.300.9-1.300 1.300-2.500 1.300-2.600-.1 0-2.400-.9-2.400-3.900zM14.200 5.800c.6-.8 1.100-1.800.9-2.800-.9 0-2 .6-2.600 1.400-.6.700-1.100 1.700-.9 2.700 1 .1 2-.5 2.600-1.300z',
  win: 'M3 5l8-1.200V11H3zM12 3.700L21 2.500V11h-9zM3 12h8v7.200L3 18zM12 12h9v9.500L12 20.300z',
};
const platTokens: string[] = [];
for (const p of game.platforms || []) {
  if (p === 'Mobile') platTokens.push('android', 'ios');
  else if (p === 'PC') platTokens.push('win');
  else platTokens.push(p);
}
type Act = { href: string; label: string; kind: string };
const primary: Act | null = game.android
  ? { href: game.android, label: 'Tải xuống', kind: 'android' }
  : game.ios
    ? { href: game.ios, label: 'Tải xuống', kind: 'ios' }
    : game.website
      ? { href: game.website, label: isMobile ? 'Trang chủ game' : 'Tải xuống', kind: 'web' }
      : null;
const secondary: Act[] = [
  game.android && primary?.kind !== 'android' ? { href: game.android, label: 'Tải Android', kind: 'android' } : null,
  game.ios && primary?.kind !== 'ios' ? { href: game.ios, label: 'Tải iOS', kind: 'ios' } : null,
  game.website && primary?.kind !== 'web' ? { href: game.website, label: 'Trang chủ game', kind: 'web' } : null,
].filter(Boolean) as Act[];
---

<Layout
  title={game.seoTitle || `${game.name} | Game8`}
  description={game.seoDescription || game.description}
  keywords={game.seoKeywords}
  ogImage={game.cover || game.icon}
  ogType="article"
  jsonLd={jsonLd}
>
  <div class="max-w-[1280px] mx-auto px-4 py-6">
    <!-- Breadcrumb -->
    <div class="text-sm muted mb-5 flex items-center gap-1.5 flex-wrap">
      <a href="/" class="hover:text-tap">Trang chủ</a><span>›</span>
      <a href={catHref} class="hover:text-tap">{catLabel}</a><span>›</span>
      <span class="font-semibold text-[#15171a] dark:text-white">{game.name}</span>
    </div>

    <!-- Đầu trang game (mobile, kiểu app-store) -->
    <div class="sm:hidden">
      <div class="flex gap-3.5">
        {game.icon ? (
          <img src={game.icon} alt={`Icon ${game.name}`} class="w-[72px] h-[72px] rounded-[20%] object-cover ring-1 ring-black/10 shrink-0 shadow" loading="eager" />
        ) : (
          <div class="w-[72px] h-[72px] rounded-[20%] bg-gradient-to-br from-tap to-cyan-500 grid place-items-center text-white text-3xl font-black shrink-0 shadow">{game.name.charAt(0)}</div>
        )}
        <div class="min-w-0 flex-1">
          <h1 class="text-xl font-extrabold leading-snug line-clamp-2">{game.name}</h1>
          <div class="mt-1 flex items-center gap-1.5 text-xs muted flex-wrap">
            {platTokens.map((t) => (
              GLYPH[t]
                ? <svg class="w-3.5 h-3.5 fill-current opacity-70" viewBox="0 0 24 24"><path d={GLYPH[t]} /></svg>
                : <b class="text-[10px] opacity-70">{t}</b>
            ))}
            <span>•</span><span>{game.genre}</span>
            {ratingVal != null && (<><span>•</span><span class="text-tap font-bold">★ {ratingVal.toFixed(1)}</span></>)}
          </div>
          <div class="mt-1 text-xs font-bold uppercase tracking-wider text-tap">{game.publisher}</div>
        </div>
      </div>
      {primary ? (
        <div class="relative mt-4">
          <div class="flex gap-2">
            <a href={primary.href} target="_blank" rel="noopener" class="btn btn-p flex-1 !h-12 !text-base">
              {primary.kind !== 'web' && GLYPH[primary.kind] && (
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d={GLYPH[primary.kind]} /></svg>
              )}
              {primary.label}
            </a>
            <button id="dl-more" type="button" aria-label="Thêm lựa chọn tải" class="btn btn-s !px-3.5 !h-12 shrink-0">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
            </button>
          </div>
          <div id="dl-menu" class="hidden absolute right-0 top-full mt-2 w-60 max-w-[85vw] rounded-2xl bg-white dark:bg-[#1b1e23] ring-1 ring-black/10 dark:ring-white/10 shadow-xl p-1.5 z-30">
            {secondary.map((a) => (
              <a href={a.href} target="_blank" rel="noopener" class="flex items-center gap-2 px-3 h-10 rounded-xl text-sm font-semibold hover:bg-black/5 dark:hover:bg-white/10">{a.label}</a>
            ))}
            {embedUrl && <a href="#trailer" class="flex items-center gap-2 px-3 h-10 rounded-xl text-sm font-semibold hover:bg-black/5 dark:hover:bg-white/10">Xem trailer</a>}
            <button type="button" class="follow-btn flex items-center gap-2 px-3 h-10 rounded-xl text-sm font-semibold hover:bg-black/5 dark:hover:bg-white/10 w-full text-left" data-slug={game.slug}>♡ Theo dõi</button>
          </div>
        </div>
      ) : (
        <button type="button" class="follow-btn btn btn-o w-full mt-4 !h-12" data-slug={game.slug}>♡ Theo dõi</button>
      )}
    </div>

    <!-- Đầu trang game (màn hình lớn) -->
    <div class="hidden sm:flex flex-row gap-5 sm:gap-7 sm:items-center">
      {game.icon ? (
        <img src={game.icon} alt={`Icon ${game.name}`} class="w-[136px] h-[136px] rounded-[22.5%] object-cover ring-1 ring-black/10 shrink-0 shadow-lg" loading="eager" />
      ) : (
        <div class="w-[136px] h-[136px] rounded-[22.5%] bg-gradient-to-br from-tap to-cyan-500 grid place-items-center text-white text-5xl font-black shrink-0 shadow-lg">{game.name.charAt(0)}</div>
      )}
      <div class="flex-1 min-w-0">
        <h1 class="text-3xl sm:text-4xl font-extrabold">{game.name}</h1>
        <div class="muted text-sm mt-1">{game.publisher}</div>
        <div class="flex flex-wrap gap-2 mt-3">
          {[game.genre, ...(game.platforms || [])].map((t) => (
            <span class="text-xs font-medium rounded-full sf px-3 py-1">{t}</span>
          ))}
        </div>
        <div class="flex gap-2 mt-4 flex-wrap">
          {game.android && (
            <a href={game.android} target="_blank" rel="noopener" class="btn btn-p">Tải Android</a>
          )}
          {game.ios && (
            <a href={game.ios} target="_blank" rel="noopener" class="btn btn-s">Tải iOS</a>
          )}
          {!game.android && !game.ios && game.website && (
            <a href={game.website} target="_blank" rel="noopener" class="btn btn-p">{isMobile ? 'Trang chủ game' : 'Tải game'}</a>
          )}
          {embedUrl && <a href="#trailer" class="btn btn-s">Xem trailer</a>}
          <button type="button" data-slug={game.slug} class="btn btn-o follow-btn">♡ Theo dõi</button>
        </div>
      </div>
      {ratingVal != null && (
        <div class="sf rounded-2xl px-7 py-4 text-center shrink-0 sm:ml-auto">
          <div class="text-5xl font-extrabold text-tap leading-none">{ratingVal.toFixed(1)}</div>
          <div class="text-amber-400 mt-2 flex justify-center gap-0.5">
            {Array.from({ length: filledStars }).map(() => (
              <svg class="w-3 h-3 fill-current" viewBox="0 0 20 20"><path d={starPath} /></svg>
            ))}
            {Array.from({ length: 5 - filledStars }).map(() => (
              <svg class="w-3 h-3 fill-current opacity-25" viewBox="0 0 20 20"><path d={starPath} /></svg>
            ))}
          </div>
          <div class="text-xs muted mt-1.5">Điểm đánh giá</div>
        </div>
      )}
    </div>

    <!-- Nội dung chính + cột phải -->
    <div class="grid lg:grid-cols-[1fr_340px] gap-8 mt-9">
      <div class="space-y-10 min-w-0">
        {embedUrl && (
          <section id="trailer">
            <h2 class="text-xl font-extrabold mb-4">Trailer</h2>
            <div id="trailer-cover" class="relative aspect-video rounded-2xl overflow-hidden cursor-pointer group ring-1 ring-black/5 dark:ring-white/10" data-embed={embedUrl}>
              {gameArt(game, postImg) ? (
                <img src={gameArt(game, postImg)} alt={`Trailer ${game.name}`} loading="lazy" class="absolute inset-0 w-full h-full object-cover" />
              ) : (
                <div class="absolute inset-0 bg-gradient-to-br from-slate-600 to-slate-950 grid place-items-center">
                  {game.icon && <img src={game.icon} alt={game.name} class="h-[72%] aspect-square object-cover rounded-[22%] opacity-80" />}
                </div>
              )}
              <div class="absolute inset-0 bg-black/20"></div>
              <span class="absolute inset-0 grid place-items-center">
                <span class="w-16 h-16 rounded-full bg-white grid place-items-center shadow-xl group-hover:scale-110 transition text-tap">
                  <svg class="w-7 h-7 ml-1" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                </span>
              </span>
            </div>
            <div id="trailer-frame" class="hidden relative aspect-video rounded-2xl overflow-hidden">
              <iframe id="trailer-iframe" title={`Trailer ${game.name}`} class="absolute inset-0 w-full h-full" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
            </div>
          </section>
        )}

        <section>
          <h2 class="text-xl font-extrabold mb-3">Giới thiệu</h2>
          <p id="game-desc" class="muted leading-relaxed line-clamp-3 sm:line-clamp-none">{game.description}</p>
          <button id="desc-more" type="button" class="sm:hidden hidden text-tap text-sm font-semibold mt-1">Thêm</button>
        </section>

        <section>
          <h2 class="text-xl font-extrabold mb-4">Cập nhật mới</h2>
          {relatedPosts.length > 0 ? (
            <div class="space-y-3">
              {relatedPosts.map((p: any) => <NewsRow post={p} game={game} postImg={postImg} />)}
            </div>
          ) : (
            <p class="muted text-sm">Chưa có cập nhật nào về {game.name}. Hãy quay lại sau!</p>
          )}
        </section>
      </div>

      <aside class="space-y-8">
        <div>
          <h2 class="text-xl font-extrabold mb-3">Thông tin game</h2>
          <dl class="sf rounded-2xl px-4 text-sm divide-y divide-black/5 dark:divide-white/10">
            <div class="flex justify-between gap-3 py-3"><dt class="muted">Nhà phát hành</dt><dd class="font-semibold text-right">{game.publisher}</dd></div>
            <div class="flex justify-between gap-3 py-3"><dt class="muted">Nền tảng</dt><dd class="font-semibold text-right">{platText}</dd></div>
            <div class="flex justify-between gap-3 py-3"><dt class="muted">Thể loại</dt><dd class="font-semibold text-right">{game.genre}</dd></div>
          </dl>
        </div>
        <div>
          <h2 class="text-xl font-extrabold mb-3">Có thể bạn thích</h2>
          <div class="space-y-1">
            {relatedGames.map((x) => (
              <a href={`/game/${x.slug}/`} class="flex items-center gap-3 p-2 rounded-xl hover:bg-black/5 dark:hover:bg-white/5 transition">
                {x.icon ? (
                  <img src={x.icon} alt={x.name} loading="lazy" class="w-14 h-14 rounded-[22.5%] object-cover ring-1 ring-black/10 shrink-0" />
                ) : (
                  <span class="w-14 h-14 rounded-[22.5%] bg-gradient-to-br from-slate-500 to-slate-800 grid place-items-center text-white font-black shrink-0">{x.name.charAt(0)}</span>
                )}
                <span class="min-w-0 flex-1">
                  <span class="block font-bold text-sm truncate">{x.name}</span>
                  <span class="block text-xs muted truncate">{x.genre} • {(x.platforms || [])[0] || ''}</span>
                </span>
                {typeof x.rating === 'number' && (
                  <span class="text-base font-extrabold text-tap leading-none shrink-0">{x.rating.toFixed(1)}</span>
                )}
              </a>
            ))}
          </div>
        </div>
      </aside>
    </div>
  </div>
</Layout>

<script>
  // ===== Trailer: bấm bìa mới nhúng video =====
  const cover = document.getElementById('trailer-cover');
  cover?.addEventListener('click', () => {
    const frame = document.getElementById('trailer-frame');
    const iframe = document.getElementById('trailer-iframe') as HTMLIFrameElement | null;
    if (frame && iframe) {
      iframe.src = (cover as HTMLElement).dataset.embed + '?autoplay=1&rel=0';
      frame.classList.remove('hidden');
      cover.classList.add('hidden');
    }
  });

  // ===== Theo dõi game (lưu trên máy người dùng) =====
  const followBtns = [...document.querySelectorAll('.follow-btn')] as HTMLButtonElement[];
  if (followBtns.length) {
    const slug = followBtns[0].dataset.slug || '';
    const KEY = 'followed-games';
    const read = (): string[] => {
      try { return JSON.parse(localStorage.getItem(KEY) || '[]'); } catch { return []; }
    };
    const paint = () => {
      const on = read().includes(slug);
      followBtns.forEach((b) => {
        b.textContent = on ? '♥ Đã theo dõi' : '♡ Theo dõi';
        b.classList.toggle('chip-on', on);
      });
    };
    followBtns.forEach((b) => b.addEventListener('click', () => {
      const list = read();
      const i = list.indexOf(slug);
      if (i >= 0) list.splice(i, 1); else list.push(slug);
      try { localStorage.setItem(KEY, JSON.stringify(list)); } catch {}
      paint();
    }));
    paint();
  }

  // ===== Menu tải phụ (mobile) =====
  const dlMore = document.getElementById('dl-more');
  const dlMenu = document.getElementById('dl-menu');
  dlMore?.addEventListener('click', (e) => {
    e.stopPropagation();
    dlMenu?.classList.toggle('hidden');
  });
  document.addEventListener('click', (e) => {
    if (dlMenu && !dlMenu.classList.contains('hidden') && !dlMenu.contains(e.target as Node)) {
      dlMenu.classList.add('hidden');
    }
  });
  dlMenu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => dlMenu.classList.add('hidden')));

  // ===== Mô tả: Thêm / Thu gọn (mobile) =====
  const desc = document.getElementById('game-desc');
  const descMore = document.getElementById('desc-more');
  if (desc && descMore) {
    if (desc.scrollHeight > desc.clientHeight + 2) descMore.classList.remove('hidden');
    descMore.addEventListener('click', () => {
      const clamped = desc.classList.toggle('line-clamp-3');
      descMore.textContent = clamped ? 'Thêm' : 'Thu gọn';
    });
  }
</script>
