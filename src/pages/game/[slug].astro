---
import Layout from '../../layouts/Layout.astro';
import NewsRow from '../../components/NewsRow.astro';
import { getCollection } from 'astro:content';
import games from '../../data/games.json';
import { gameArt, latestPostImageMap } from '../../lib/gameArt';

export async function getStaticPaths() {
  const entries = await getCollection('posts');
  const fmt = (d: any) =>
    d ? new Date(d).toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' }) : '';
  const posts = entries.map((p) => ({
    slug: p.id.replace(/\.(md|mdx)$/i, ''),
    title: p.data.title,
    description: p.data.description || '',
    image: p.data.image || '',
    tag: (p.data.tags && p.data.tags[0]) || 'Tin tức',
    tags: p.data.tags || [],
    dateText: fmt(p.data.date),
    _ts: p.data.date ? new Date(p.data.date).getTime() : 0,
    gameSlug: p.data.game || '',
  }));
  const imgMap = latestPostImageMap(posts);
  return games.map((game) => ({
    params: { slug: game.slug },
    props: {
      game,
      relatedPosts: posts.filter((p) => p.gameSlug === game.slug).sort((a, b) => b._ts - a._ts),
      postImg: imgMap[game.slug] || '',
    },
  }));
}

const { game, relatedPosts, postImg } = Astro.props;

const isMobile = game.category === 'mobile';
const catHref = isMobile ? '/mobile/' : '/pc/';
const catLabel = isMobile ? 'Game Mobile' : 'Game PC / Console';
const platText = (game.platforms || []).join(' · ');

const relatedGames = games
  .filter((g) => g.slug !== game.slug && g.category === game.category)
  .sort((a, b) => {
    const sa = a.genre === game.genre ? 0 : 1;
    const sb = b.genre === game.genre ? 0 : 1;
    return sa - sb;
  })
  .slice(0, 4);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "VideoGame",
  "name": game.name,
  "description": game.description,
  "genre": game.genre,
  "publisher": { "@type": "Organization", "name": game.publisher },
  ...(game.icon && { "image": game.icon }),
  ...(game.trailer && { "trailer": { "@type": "VideoObject", "embedUrl": game.trailer } }),
};

function youtubeEmbed(url: string): string {
  if (!url) return '';
  const m = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/)([a-zA-Z0-9_-]+)/);
  return m ? `https://www.youtube.com/embed/${m[1]}` : '';
}

const embedUrl = youtubeEmbed(game.trailer);
---

<Layout
  title={game.seoTitle || `${game.name} | Game8.VN`}
  description={game.seoDescription || game.description}
  keywords={game.seoKeywords}
  ogImage={game.cover || game.icon}
  ogType="article"
  jsonLd={jsonLd}
>
  <div class="max-w-[1280px] mx-auto px-4 py-6">
    <!-- Breadcrumb -->
    <div class="text-sm muted mb-5 flex items-center gap-1.5 flex-wrap">
      <a href="/" class="hover:text-tap">Trang chủ</a><span>›</span>
      <a href={catHref} class="hover:text-tap">{catLabel}</a><span>›</span>
      <span class="font-semibold text-[#15171a] dark:text-white">{game.name}</span>
    </div>

    <!-- Đầu trang game -->
    <div class="flex flex-col sm:flex-row gap-5 sm:gap-7 sm:items-center">
      {game.icon ? (
        <img src={game.icon} alt={`Icon ${game.name}`} class="w-[136px] h-[136px] rounded-[22.5%] object-cover ring-1 ring-black/10 shrink-0 shadow-lg" loading="eager" />
      ) : (
        <div class="w-[136px] h-[136px] rounded-[22.5%] bg-gradient-to-br from-tap to-cyan-500 grid place-items-center text-white text-5xl font-black shrink-0 shadow-lg">{game.name.charAt(0)}</div>
      )}
      <div class="flex-1 min-w-0">
        <h1 class="text-3xl sm:text-4xl font-extrabold">{game.name}</h1>
        <div class="muted text-sm mt-1">{game.publisher}</div>
        <div class="flex flex-wrap gap-2 mt-3">
          {[game.genre, ...(game.platforms || [])].map((t) => (
            <span class="text-xs font-medium rounded-full sf px-3 py-1">{t}</span>
          ))}
        </div>
        <div class="flex gap-2 mt-4 flex-wrap">
          {game.website && (
            <a href={game.website} target="_blank" rel="noopener" class="btn btn-p">Trang chủ game</a>
          )}
          {embedUrl && <a href="#trailer" class="btn btn-s">Xem trailer</a>}
          <button id="follow-btn" data-slug={game.slug} class="btn btn-o">♡ Theo dõi</button>
        </div>
      </div>
      <div class="sf rounded-2xl px-7 py-4 text-center shrink-0 sm:ml-auto">
        <div class="text-2xl font-extrabold text-tap leading-tight">{isMobile ? 'Mobile' : 'PC · Console'}</div>
        <div class="text-sm muted mt-1">{platText}</div>
        <div class="text-xs muted mt-1">{game.genre}</div>
      </div>
    </div>

    <!-- Nội dung chính + cột phải -->
    <div class="grid lg:grid-cols-[1fr_340px] gap-8 mt-9">
      <div class="space-y-10 min-w-0">
        {embedUrl && (
          <section id="trailer">
            <h2 class="text-xl font-extrabold mb-4">Trailer</h2>
            <div id="trailer-cover" class="relative aspect-video rounded-2xl overflow-hidden cursor-pointer group ring-1 ring-black/5 dark:ring-white/10" data-embed={embedUrl}>
              {gameArt(game, postImg) ? (
                <img src={gameArt(game, postImg)} alt={`Trailer ${game.name}`} loading="lazy" class="absolute inset-0 w-full h-full object-cover" />
              ) : (
                <div class="absolute inset-0 bg-gradient-to-br from-slate-600 to-slate-950 grid place-items-center">
                  {game.icon && <img src={game.icon} alt={game.name} class="h-[72%] aspect-square object-cover rounded-[22%] opacity-80" />}
                </div>
              )}
              <div class="absolute inset-0 bg-black/20"></div>
              <span class="absolute inset-0 grid place-items-center">
                <span class="w-16 h-16 rounded-full bg-white grid place-items-center shadow-xl group-hover:scale-110 transition text-tap">
                  <svg class="w-7 h-7 ml-1" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                </span>
              </span>
            </div>
            <div id="trailer-frame" class="hidden relative aspect-video rounded-2xl overflow-hidden">
              <iframe id="trailer-iframe" title={`Trailer ${game.name}`} class="absolute inset-0 w-full h-full" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
            </div>
          </section>
        )}

        <section>
          <h2 class="text-xl font-extrabold mb-3">Giới thiệu</h2>
          <p class="muted leading-relaxed">{game.description}</p>
        </section>

        <section>
          <h2 class="text-xl font-extrabold mb-4">Cập nhật mới</h2>
          {relatedPosts.length > 0 ? (
            <div class="space-y-3">
              {relatedPosts.map((p: any) => <NewsRow post={p} game={game} postImg={postImg} />)}
            </div>
          ) : (
            <p class="muted text-sm">Chưa có bài viết nào về {game.name}. Hãy quay lại sau!</p>
          )}
        </section>
      </div>

      <aside class="space-y-8">
        <div>
          <h2 class="text-xl font-extrabold mb-3">Thông tin game</h2>
          <dl class="sf rounded-2xl px-4 text-sm divide-y divide-black/5 dark:divide-white/10">
            <div class="flex justify-between gap-3 py-3"><dt class="muted">Nhà phát hành</dt><dd class="font-semibold text-right">{game.publisher}</dd></div>
            <div class="flex justify-between gap-3 py-3"><dt class="muted">Nền tảng</dt><dd class="font-semibold text-right">{platText}</dd></div>
            <div class="flex justify-between gap-3 py-3"><dt class="muted">Thể loại</dt><dd class="font-semibold text-right">{game.genre}</dd></div>
            {game.website && (
              <div class="flex justify-between gap-3 py-3"><dt class="muted">Website</dt><dd class="font-semibold text-right"><a href={game.website} target="_blank" rel="noopener" class="text-tap hover:underline">Trang chủ</a></dd></div>
            )}
          </dl>
        </div>
        <div>
          <h2 class="text-xl font-extrabold mb-3">Có thể bạn thích</h2>
          <div class="space-y-1">
            {relatedGames.map((x) => (
              <a href={`/game/${x.slug}/`} class="flex items-center gap-3 p-2 rounded-xl hover:bg-black/5 dark:hover:bg-white/5 transition">
                {x.icon ? (
                  <img src={x.icon} alt={x.name} loading="lazy" class="w-14 h-14 rounded-[22.5%] object-cover ring-1 ring-black/10 shrink-0" />
                ) : (
                  <span class="w-14 h-14 rounded-[22.5%] bg-gradient-to-br from-slate-500 to-slate-800 grid place-items-center text-white font-black shrink-0">{x.name.charAt(0)}</span>
                )}
                <span class="min-w-0 flex-1">
                  <span class="block font-bold text-sm truncate">{x.name}</span>
                  <span class="block text-xs muted truncate">{x.genre} • {(x.platforms || [])[0] || ''}</span>
                </span>
              </a>
            ))}
          </div>
        </div>
      </aside>
    </div>
  </div>
</Layout>

<script>
  // ===== Trailer: bấm bìa mới nhúng video =====
  const cover = document.getElementById('trailer-cover');
  cover?.addEventListener('click', () => {
    const frame = document.getElementById('trailer-frame');
    const iframe = document.getElementById('trailer-iframe') as HTMLIFrameElement | null;
    if (frame && iframe) {
      iframe.src = (cover as HTMLElement).dataset.embed + '?autoplay=1&rel=0';
      frame.classList.remove('hidden');
      cover.classList.add('hidden');
    }
  });

  // ===== Theo dõi game (lưu trên máy người dùng) =====
  const btn = document.getElementById('follow-btn') as HTMLButtonElement | null;
  if (btn) {
    const slug = btn.dataset.slug || '';
    const KEY = 'followed-games';
    const read = (): string[] => {
      try { return JSON.parse(localStorage.getItem(KEY) || '[]'); } catch { return []; }
    };
    const paint = () => {
      const on = read().includes(slug);
      btn.textContent = on ? '♥ Đã theo dõi' : '♡ Theo dõi';
      btn.classList.toggle('chip-on', on);
    };
    btn.addEventListener('click', () => {
      const list = read();
      const i = list.indexOf(slug);
      if (i >= 0) list.splice(i, 1); else list.push(slug);
      try { localStorage.setItem(KEY, JSON.stringify(list)); } catch {}
      paint();
    });
    paint();
  }
</script>
