---
interface Props {
  title: string;
  description: string;
  keywords?: string;
  ogImage?: string;
  ogType?: string;
  canonical?: string;
  jsonLd?: object;
}

const { title, description, keywords, ogImage, ogType = 'website', canonical, jsonLd } = Astro.props;
const siteName = 'Game8.VN';
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;
---

<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {keywords && <meta name="keywords" content={keywords} />}
  <meta name="robots" content="index, follow" />
  <meta name="theme-color" content="#dc2626" />
  <link rel="canonical" href={canonical || Astro.url.href} />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta property="og:url" content={Astro.url.href} />
  <meta property="og:locale" content="vi_VN" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}

  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Khởi tạo Theme chống nhấp nháy giao diện -->
  <script is:inline>
    (function(){
      const lightColor = "#dc2626";
      const darkColor = "#111827";
      const localStorageTheme = localStorage.getItem('theme');
      const systemSettingDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (localStorageTheme === 'dark' || (!localStorageTheme && systemSettingDark)) {
        document.documentElement.classList.add('dark');
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', darkColor);
      } else {
        document.documentElement.classList.remove('dark');
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', lightColor);
      }
    })();
  </script>
</head>
<body class="bg-gray-50 dark:bg-slate-950 text-gray-900 dark:text-slate-100 min-h-screen flex flex-col antialiased transition-colors duration-200">
  <header class="bg-white dark:bg-slate-900/95 backdrop-blur shadow-sm dark:shadow-lg sticky top-0 z-50 border-b border-gray-200 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2">
        <span class="text-2xl font-extrabold text-red-600 dark:text-red-500">Game8<span class="text-gray-900 dark:text-white">.VN</span></span>
      </a>
      <div class="flex items-center gap-4">
        <nav class="hidden md:flex gap-6 text-sm font-semibold text-gray-700 dark:text-slate-300">
          <a href="/" class="hover:text-red-600 dark:hover:text-red-400 transition">Trang chủ</a>
          <a href="/#mobile" class="hover:text-red-600 dark:hover:text-red-400 transition">Game Mobile</a>
          <a href="/#pc-console" class="hover:text-red-600 dark:hover:text-red-400 transition">Game PC/Console</a>
          <a href="/tin-tuc" class="hover:text-red-600 dark:hover:text-red-400 transition">Tin tức</a>
        </nav>
        <button
          id="theme-toggle"
          type="button"
          aria-label="Thay đổi chế độ giao diện"
          class="p-2 text-gray-600 dark:text-slate-300 hover:text-red-600 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-white/10 rounded-lg transition-all focus:outline-none flex items-center justify-center shrink-0 w-9 h-9"
        >
          <svg id="theme-toggle-dark-icon" class="hidden h-5 w-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"></path>
          </svg>
          <svg id="theme-toggle-light-icon" class="hidden h-5 w-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m0 13.5V21m8.966-8.966h-2.25m-13.5 0H3m15.364 6.364l-1.591-1.591M6.759 6.759L5.168 5.168m12.728 0l-1.591 1.591M6.759 17.241l-1.591 1.591M12 15a3 3 0 100-6 3 3 0 000 6z"></path>
          </svg>
        </button>
      </div>
    </div>
  </header>

  <main class="flex-1">
    <slot />
  </main>

  <footer class="bg-gray-900 dark:bg-black text-gray-300 mt-12">
    <div class="max-w-7xl mx-auto px-4 py-8">
      <div class="flex flex-col md:flex-row justify-between gap-6">
        <div>
          <p class="text-xl font-extrabold text-white">Game8<span class="text-red-500">.VN</span></p>
          <p class="text-sm mt-2">Cổng thông tin game Việt Nam — tải game, tin tức, review.</p>
        </div>
        <div class="text-sm">
          <p class="font-bold text-white mb-2">Liên kết</p>
          <ul class="space-y-1">
            <li><a href="/" class="hover:text-white">Trang chủ</a></li>
            <li><a href="/tin-tuc" class="hover:text-white">Tin tức</a></li>
          </ul>
        </div>
      </div>
      <p class="text-xs text-gray-500 mt-6 pt-6 border-t border-gray-800">© 2026 Game8.VN. All rights reserved.</p>
    </div>
  </footer>

  <script>
    function initToggle() {
      const darkIcon = document.getElementById('theme-toggle-dark-icon');
      const lightIcon = document.getElementById('theme-toggle-light-icon');
      if (!darkIcon || !lightIcon) return;
      darkIcon.classList.add('hidden');
      lightIcon.classList.add('hidden');
      if (document.documentElement.classList.contains('dark')) {
        lightIcon.classList.remove('hidden');
      } else {
        darkIcon.classList.remove('hidden');
      }
    }
    initToggle();
    document.addEventListener('astro:page-load', initToggle);
    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      const darkIcon = document.getElementById('theme-toggle-dark-icon');
      const lightIcon = document.getElementById('theme-toggle-light-icon');
      if (!darkIcon || !lightIcon) return;
      const isDark = document.documentElement.classList.toggle('dark');
      lightIcon.classList.toggle('hidden', !isDark);
      darkIcon.classList.toggle('hidden', isDark);
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', isDark ? '#111827' : '#dc2626');
    });
  </script>
</body>
</html>
