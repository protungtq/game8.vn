---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import games from '../data/games.json';

interface Props {
  title: string;
  description: string;
  keywords?: string;
  ogImage?: string;
  ogType?: string;
  canonical?: string;
  jsonLd?: object;
}

const { title, description, keywords, ogImage, ogType = 'website', canonical, jsonLd } = Astro.props;
const siteName = 'Game8.VN';
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;

// ===== Mục lục tìm kiếm (game + bài viết) =====
const postEntries = await getCollection('posts');
const gameBySlug = Object.fromEntries(games.map((g) => [g.slug, g]));
const searchIndex = [
  ...games.map((g) => ({
    t: g.name,
    s: `${g.genre} · ${g.publisher}`,
    u: `/game/${g.slug}/`,
    i: g.icon || '',
  })),
  ...postEntries.map((p) => ({
    t: p.data.title,
    s: gameBySlug[p.data.game]?.name || 'Tin tức',
    u: `/tin/${p.id.replace(/\.(md|mdx)$/i, '')}/`,
    i: p.data.image || gameBySlug[p.data.game]?.icon || '',
  })),
];

// ===== Điều hướng =====
const path = Astro.url.pathname;
const NAV = [
  { href: '/', label: 'Trang chủ', icon: '<path d="M3 11l9-8 9 8v9a1 1 0 01-1 1h-5v-6H9v6H4a1 1 0 01-1-1z"/>' },
  { href: '/mobile/', label: 'Game Mobile', icon: '<rect x="7" y="2" width="10" height="20" rx="2.5"/><path d="M11 18h2"/>' },
  { href: '/pc/', label: 'PC / Console', icon: '<rect x="2" y="4" width="20" height="13" rx="2"/><path d="M8 21h8M12 17v4"/>' },
  { href: '/tin-tuc/', label: 'Cập nhật', icon: '<path d="M6 8a6 6 0 0112 0c0 7 3 8 3 8H3s3-1 3-8M10 21h4"/>' },
];
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href) || (href === '/tin-tuc/' && path.startsWith('/tin/'));
---

<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {keywords && <meta name="keywords" content={keywords} />}
  <meta name="robots" content="index, follow" />
  <meta name="theme-color" content="#ffffff" />
  <link rel="canonical" href={canonical || Astro.url.href} />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta property="og:url" content={Astro.url.href} />
  <meta property="og:locale" content="vi_VN" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}

  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

  <!-- Khởi tạo Theme chống nhấp nháy giao diện -->
  <script is:inline>
    (function () {
      var t = null;
      try { t = localStorage.getItem('theme'); } catch (e) {}
      if (!t) t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.documentElement.classList.toggle('dark', t === 'dark');
      var m = document.querySelector('meta[name="theme-color"]');
      if (m) m.setAttribute('content', t === 'dark' ? '#111316' : '#ffffff');
    })();
  </script>
</head>
<body>
  <header class="sticky top-[env(safe-area-inset-top,0px)] z-50 bg-white/95 dark:bg-[#111316]/95 backdrop-blur shadow-[0_6px_24px_-10px_rgba(0,0,0,.25)] border-b border-black/5 dark:border-white/10">
    <div class="h-[3px] bg-gradient-to-r from-tap via-cyan-400 to-violet-500"></div>
    <div class="max-w-[1280px] mx-auto px-4 h-[72px] flex items-center gap-4 sm:gap-5">
      <a href="/" class="flex items-center gap-2 font-black text-2xl tracking-tight shrink-0">
        <span class="w-10 h-10 rounded-xl bg-gradient-to-br from-tap to-cyan-500 shadow-lg shadow-tap/30 grid place-items-center">
          <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="11" rx="5"/><path d="M7 10v5M4.5 12.5h5M16 11.5h.01M18.5 14h.01"/></svg>
        </span>
        Game8<span class="text-tap -ml-2">.VN</span>
      </a>
      <nav class="hidden md:flex gap-1 text-sm font-semibold">
        {NAV.map((n) => (
          <a href={n.href} class={`px-4 h-10 grid place-items-center rounded-full transition ${isActive(n.href) ? 'bg-tap text-white shadow-md shadow-tap/30' : 'hover:bg-black/5 dark:hover:bg-white/10'}`}>{n.label}</a>
        ))}
      </nav>
      <div class="relative flex-1 max-w-xl ml-auto">
        <svg class="w-4 h-4 absolute left-4 top-1/2 -translate-y-1/2 muted pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
        <input id="q" placeholder="Trò chơi, bài viết và nhà phát hành" autocomplete="off" class="w-full h-11 rounded-full bg-[#e8eaec] dark:bg-white/10 pl-11 pr-4 text-sm outline-none focus:ring-2 ring-tap" />
        <div id="sr" class="hidden absolute left-0 right-0 top-full mt-2 rounded-2xl bg-white dark:bg-[#1b1e23] ring-1 ring-black/10 dark:ring-white/10 shadow-xl p-2 max-h-80 overflow-auto z-50"></div>
      </div>
      <button id="tg" type="button" aria-label="Chuyển giao diện sáng / tối" title="Sáng / tối" class="w-11 h-11 shrink-0 rounded-full sf grid place-items-center hover:bg-black/10 dark:hover:bg-white/15 transition">
        <svg class="w-5 h-5 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="w-5 h-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"/></svg>
      </button>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <nav class="md:hidden fixed bottom-0 inset-x-0 z-50 grid grid-cols-4 bg-white/95 dark:bg-[#111316]/95 backdrop-blur border-t border-black/5 dark:border-white/10 pb-[env(safe-area-inset-bottom,0px)]">
    {NAV.map((n) => (
      <a href={n.href} class={`flex flex-col items-center gap-1 py-2.5 text-[11px] font-semibold ${isActive(n.href) ? 'text-tap' : 'muted'}`}>
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={n.icon}></svg>
        {n.label}
      </a>
    ))}
  </nav>

  <footer class="mt-16 bg-[#0e1114] text-slate-300">
    <div class="h-[3px] bg-gradient-to-r from-tap via-cyan-400 to-violet-500"></div>
    <div class="max-w-[1280px] mx-auto px-4 py-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr_1fr]">
      <div>
        <div class="flex items-center gap-2 font-black text-2xl text-white">
          <span class="w-10 h-10 rounded-xl bg-gradient-to-br from-tap to-cyan-500 grid place-items-center">
            <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="11" rx="5"/><path d="M7 10v5M4.5 12.5h5M16 11.5h.01M18.5 14h.01"/></svg>
          </span>
          Game8<span class="text-tap -ml-2">.VN</span>
        </div>
        <p class="mt-4 text-sm leading-relaxed text-slate-400 max-w-xs">Khám phá, theo dõi và cập nhật tin tức những tựa game mobile, PC và console đáng chơi nhất.</p>
      </div>
      <div>
        <h4 class="font-bold text-white mb-3">Khám phá</h4>
        <ul class="space-y-2 text-sm">
          <li><a class="hover:text-tap" href="/">Trang chủ</a></li>
          <li><a class="hover:text-tap" href="/mobile/">Game Mobile</a></li>
          <li><a class="hover:text-tap" href="/pc/">Game PC / Console</a></li>
          <li><a class="hover:text-tap" href="/tin-tuc/">Cập nhật mới</a></li>
        </ul>
      </div>
      <div>
        <h4 class="font-bold text-white mb-3">Nền tảng</h4>
        <ul class="space-y-2 text-sm">
          <li><a class="hover:text-tap" href="/mobile/">Android</a></li>
          <li><a class="hover:text-tap" href="/mobile/">iOS</a></li>
          <li><a class="hover:text-tap" href="/pc/">PC</a></li>
          <li><a class="hover:text-tap" href="/pc/">PlayStation · Xbox · Switch</a></li>
        </ul>
      </div>
      <div>
        <h4 class="font-bold text-white mb-3">Kết nối</h4>
        <ul class="space-y-2 text-sm">
          <li><a class="hover:text-tap" href="https://www.facebook.com/game8.vn" target="_blank" rel="noopener">Facebook: Game8.VN</a></li>
          <li><a class="hover:text-tap" href="https://www.tiktok.com/@Game8.VN" target="_blank" rel="noopener">TikTok: @Game8.VN</a></li>
          <li><a class="hover:text-tap" href="https://game8.info" target="_blank" rel="noopener">Blog: game8.info</a></li>
        </ul>
      </div>
    </div>
    <div class="border-t border-white/10">
      <div class="max-w-[1280px] mx-auto px-4 py-5 text-xs text-slate-500 flex flex-wrap justify-between gap-2">
        <span>© 2026 Game8.VN — Cổng thông tin game Việt Nam.</span>
        <span>Điều khoản · Chính sách bảo mật</span>
      </div>
    </div>
  </footer>

  <script is:inline define:vars={{ searchIndex }}>
    // ===== Sáng / tối =====
    function setTheme(t) {
      document.documentElement.classList.toggle('dark', t === 'dark');
      try { localStorage.setItem('theme', t); } catch (e) {}
      var m = document.querySelector('meta[name="theme-color"]');
      if (m) m.setAttribute('content', t === 'dark' ? '#111316' : '#ffffff');
    }
    var tgBtn = document.getElementById('tg');
    if (tgBtn) tgBtn.addEventListener('click', function () {
      setTheme(document.documentElement.classList.contains('dark') ? 'light' : 'dark');
    });

    // ===== Tìm kiếm =====
    var norm = function (s) {
      return (s || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/đ/g, 'd');
    };
    var q = document.getElementById('q');
    var sr = document.getElementById('sr');
    function hideSr() { if (sr) sr.classList.add('hidden'); }
    if (q && sr) {
      q.addEventListener('input', function () {
        var v = norm(q.value.trim());
        if (!v) { hideSr(); return; }
        var r = searchIndex.filter(function (x) { return norm(x.t + ' ' + x.s).includes(v); }).slice(0, 8);
        sr.innerHTML = r.length
          ? r.map(function (x) {
              return '<a href="' + x.u + '" class="flex items-center gap-3 p-2 rounded-xl hover:bg-black/5 dark:hover:bg-white/10">' +
                (x.i ? '<img src="' + x.i + '" alt="" class="w-10 h-10 rounded-[22%] object-cover shrink-0" loading="lazy">' : '<span class="w-10 h-10 rounded-[22%] bg-tap/15 shrink-0"></span>') +
                '<span class="min-w-0"><span class="block font-bold text-sm truncate">' + x.t + '</span>' +
                '<span class="block text-xs muted truncate">' + x.s + '</span></span></a>';
            }).join('')
          : '<div class="p-3 text-sm muted">Không tìm thấy kết quả phù hợp</div>';
        sr.classList.remove('hidden');
      });
      q.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') hideSr();
        if (e.key === 'Enter') {
          var first = sr.querySelector('a');
          if (first) window.location.href = first.getAttribute('href');
        }
      });
      document.addEventListener('click', function (e) {
        if (!sr.contains(e.target) && e.target !== q) hideSr();
      });
    }
  </script>
</body>
</html>
